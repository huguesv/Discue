<ContentPage
    x:Class="Woohoo.Discue.Avalonia.Views.HomePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Woohoo.Discue.Avalonia.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MainViewModel"
    Header="Home"
    mc:Ignorable="d">

    <Grid Margin="20">
        <StackPanel IsVisible="{Binding !Home.HasRecentDiscs, Mode=OneWay}" Orientation="Horizontal">
            <Image
                Width="250"
                Margin="30,0"
                Source="avares://Woohoo.Discue.Avalonia/Assets/Meet.png" />
            <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                <TextBlock
                    Margin="10,0"
                    HorizontalAlignment="Left"
                    Text="Meet Discue" />
                <TextBlock
                    MaxWidth="300"
                    Margin="10"
                    HorizontalAlignment="Left"
                    Text="Discue plays music from CDs in bin/cue, zipped bin/cue and chd format."
                    TextWrapping="Wrap" />
                <Button
                    Margin="10"
                    HorizontalAlignment="Left"
                    Command="{Binding Home.BrowseCommand, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <ic:SymbolIcon FontSize="16" Symbol="FolderOpen" />
                        <TextBlock Margin="5,0,0,0" Text="Open file" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <Grid IsVisible="{Binding Home.HasRecentDiscs, Mode=OneWay}" RowDefinitions="Auto,*,Auto">
            <TextBlock
                Grid.Row="0"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Recent discs" />

            <ListBox
                Grid.Row="1"
                Margin="0,10,0,0"
                Padding="0,0,20,0"
                Background="Transparent"
                DoubleTapped="RecentDiscsListBox_DoubleTapped"
                ItemsSource="{Binding Home.RecentDiscs, Mode=OneWay}"
                KeyUp="RecentDiscsListBox_KeyUp">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
                        <Setter Property="Margin" Value="0,1,0,2" />
                        <Setter Property="Padding" Value="5" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Background="Transparent"
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="20"
                            ToolTip.Tip="{Binding AlbumFilePath, Mode=OneWay}">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding LoadAlbumCommand, Mode=OneWay}" Header="Open" />
                                    <MenuItem Command="{Binding RemoveFromRecentCommand, Mode=OneWay}" Header="Remove" />
                                    <Separator />
                                    <MenuItem Command="{Binding ClearAllFromRecentCommand, Mode=OneWay}" Header="Clear All" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Viewbox
                                Grid.Column="0"
                                Width="48"
                                Height="48"
                                IsVisible="{Binding !AlbumArt.HasImage, Mode=OneWay}">
                                <ic:SymbolIcon FontSize="32" Symbol="MusicNote2" />
                            </Viewbox>
                            <Image
                                Grid.Column="0"
                                Width="48"
                                Height="48"
                                IsVisible="{Binding AlbumArt.HasImage, Mode=OneWay}"
                                Source="{Binding AlbumArt.LocalImage, Mode=OneWay}" />
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <TextBlock
                                    Background="Transparent"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{Binding FullAlbumTitle, Mode=OneWay}"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Background="Transparent"
                                    FontSize="12"
                                    Text="{Binding AlbumFilePath, Mode=OneWay}"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button
                Grid.Row="2"
                Margin="0,10"
                HorizontalAlignment="Right"
                Command="{Binding Home.BrowseCommand, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                    <ic:SymbolIcon FontSize="16" Symbol="FolderOpen" />
                    <TextBlock Margin="5,0,0,0" Text="Open file" />
                </StackPanel>
            </Button>

        </Grid>
    </Grid>

</ContentPage>
